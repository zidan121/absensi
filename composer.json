{
  "name": "zidan121/neuro-absensi",
  "description": "Aplikasi absensi lokal NEURO ABSENSI untuk Yayasan Bina Insani Grobogan",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.6",
    "phpoffice/phpspreadsheet": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "@php spark cache:clear"
    ],
    "test": "php spark test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}